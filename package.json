{
  "name": "captain-pos",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "author": "منظومة الكابتن",
  "description": "منظومة الكابتن — لهندسة الأرقام وريادة الأعمال",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:watch": "tsx --watch server.ts",
    "electron": "electron .",
    "electron:dev": "npm run dev & sleep 2 && electron .",
    "prebuild": "node prebuild.js",
    "build": "npm run prebuild && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:watch": "vite build --watch",
    "server:watch": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --watch",
    "auto": "concurrently \"npm:build:watch\" \"npm:server:watch\"",
    "start": "node dist/server.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "ship:win": "npm run build && npm run dist:win",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.captain.pos",
    "productName": "منظومة الكابتن",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "server.cjs"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app-runtime/dist"
      },
      {
        "from": "public",
        "to": "app-runtime/public"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "CaptainPOS-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "منظومة الكابتن",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "CaptainPOS-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "sqlite3": "5.1.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
